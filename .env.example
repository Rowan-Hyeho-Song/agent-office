# Room mode (inside the rowansong.dev desk page); all optional
# comma-separated origins allowed to embed the office (default https://rowansong-dev.vercel.app,https://rowansong.dev)
VITE_ROOM_PARENT_ORIGINS=http://localhost:5187
# where the standalone "← 책상으로" goes (default https://rowansong-dev.vercel.app/ — the desk site live now)
# VITE_DESK_URL=https://rowansong-dev.vercel.app/
# build-time (not VITE_): where the app is served from. Default: /rooms/office/app/ on Vercel builds (VERCEL is set), / locally. OFFICE_BASE overrides both; vercel.json serves that prefix on the own domain too
