# Room mode (inside the rowansong.dev desk page); all optional
# comma-separated origins allowed to embed the office (default https://rowansong.dev)
VITE_ROOM_PARENT_ORIGINS=http://localhost:5187
# where the standalone "← 책상으로" goes (default https://rowansong.dev/)
# VITE_DESK_URL=https://rowansong.dev/
# build-time (not VITE_): where the app is served from, e.g. OFFICE_BASE=/rooms/office/app/ (default /). Production (Vercel env, Production + Preview): OFFICE_BASE=/rooms/office/app/ ; vercel.json serves that prefix on the own domain too
