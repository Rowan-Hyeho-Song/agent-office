{
  "git": {
    "deploymentEnabled": {
      "main": true,
      "**": false
    }
  },
  "rewrites": [
    {
      "source": "/rooms/office/app",
      "destination": "/index.html"
    },
    {
      "source": "/rooms/office/app/",
      "destination": "/index.html"
    },
    {
      "source": "/rooms/office/app/:path+",
      "destination": "/:path+"
    }
  ]
}
